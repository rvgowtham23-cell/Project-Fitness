# Server
PORT=3000
NODE_ENV=development

# Postgres (see docs/architecture-plan.md §D, §F)
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_dev
DATABASE_SSL=false

# JWT (RS256 recommended in production; HS256 secrets below for local dev — see §D Auth row)
JWT_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis (ElastiCache in prod) — rollup caching, quota counters, BullMQ backing store
REDIS_URL=redis://localhost:6379

# AWS S3 (meal photos, processed image variants — never stored in Postgres)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=fitness-media-dev
S3_PRESIGN_EXPIRES_SECONDS=300

# AI Gateway -> external Python/FastAPI AI service (apps/ai-service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

# OAuth (stubbed — see identity module TODOs)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
