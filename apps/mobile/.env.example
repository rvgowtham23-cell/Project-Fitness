# Copy to .env and fill in for local development. Expo inlines any EXPO_PUBLIC_-prefixed
# var into the JS bundle at build time — treat everything here as PUBLIC, client-visible
# config, never a secret (auth tokens are handled at runtime, not baked in here).

# Base URL of apps/backend's NestJS API (see docs/architecture-plan.md §G for the
# /api/v1 route contract this app is built against).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
