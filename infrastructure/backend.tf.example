# Example remote-state config - NOT live. No state bucket or lock table
# exists yet. Once they're provisioned (once, by hand or via a small
# bootstrap Terraform run that itself uses local state), copy this file to
# `backend.tf` inside each environments/<env>/ directory, filling in the
# real bucket/table names, and run `terraform init -migrate-state`.
#
# One state bucket, one key prefix per environment - keeps staging and
# production state fully isolated so a mistake in one cannot touch the
# other's state file.

terraform {
  backend "s3" {
    bucket         = "fitness-platform-terraform-state"
    key            = "ENVIRONMENT_NAME/terraform.tfstate" # e.g. "staging/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "fitness-platform-terraform-locks"
    encrypt        = true
  }
}

