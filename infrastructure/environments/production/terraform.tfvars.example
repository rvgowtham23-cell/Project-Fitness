# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored - never commit real secrets/ARNs here.
# Production applies should run through the deploy-production.yml pipeline
# with reviewer approval, not from a laptop.

aws_region  = "ap-south-1"
environment = "production"
project     = "fitness-platform"

certificate_arn         = "arn:aws:acm:ap-south-1:123456789012:certificate/REPLACE_ME"
meal_images_bucket_name = "fitness-platform-production-meal-images-REPLACE_WITH_ACCOUNT_ID"

# Prefer TF_VAR_db_master_password / TF_VAR_anthropic_api_key or a CI secret
# store over putting real values in this file, even locally.
db_master_username = "fitness_app"
db_master_password = "REPLACE_ME"
anthropic_api_key  = "REPLACE_ME"

backend_image    = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/fitness-platform-backend:latest"
ai_service_image = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/fitness-platform-ai-service:latest"

rds_instance_class = "db.t4g.medium"
redis_node_type    = "cache.t4g.small"

backend_cpu                     = 512
backend_memory                  = 1024
backend_desired_count           = 2
backend_autoscaling_max_capacity = 6

ai_service_cpu                      = 1024
ai_service_memory                   = 2048
ai_service_desired_count            = 2
ai_service_autoscaling_max_capacity = 6

enable_cloudfront = false
